# Node.jsのltsの最新セキュリティリリース（22.23.4）に変更
FROM node:22.23.4

# 必要なパッケージをインストール
RUN apt-get update && apt-get install -y libc6-dev git curl dotenv && rm -rf /var/lib/apt/lists/*

# アプリケーションディレクトリを作成
WORKDIR /front

# package.jsonとyarn.lockをコピーしてyarn install
COPY ./package.json ./yarn.lock ./
RUN yarn install --frozen-lockfile

# アプリケーションコードを.(/front/)にコピー
COPY . .